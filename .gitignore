# ============================================================
#  3d_print_model_generator — repo holds CODE ONLY.
#  Models (259 GB), venvs, and heavy vendored repos are
#  re-downloaded / re-cloned on the workstation at deploy time.
# ============================================================

# --- Model weights & checkpoints (259 GB) ---
models/
**/models/
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.onnx
*.gguf

# --- Python virtual envs (Windows, not portable) ---
*_venv/
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# --- Heavy vendored third-party repos (cloned in Docker) ---
tabletop/comfyui/
tabletop/hunyuan3d/
tabletop/sparc3d/
tabletop/Hunyuan3D-2/
tabletop/Hunyuan3D-2.1/
tabletop/Pixal3D/
tabletop/TripoSG/
tabletop/CraftsMan3D/
tabletop/MV-Adapter/

# --- Generated outputs & scratch ---
tabletop/outputs/
*.glb
*.stl
*.obj
*.ply
*.3mf
*.log
*.err

# --- Node ---
node_modules/

# --- Editor / OS / agent scratch ---
.claude/
.agents/
.DS_Store
Thumbs.db
*.tmp

# --- Secrets ---
.env
*.env
!*.env.example
