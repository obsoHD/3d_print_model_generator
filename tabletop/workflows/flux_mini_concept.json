{
  "_comment": "FLUX-dev workflow for tabletop MINI concept art. Plain background, single subject, even lighting — ideal Sparc3D input. Save in ComfyUI API format if you edit in the GUI.",
  "_placeholders": {
    "$PROMPT$": "user prompt substituted at runtime",
    "$NEG$": "negative prompt substituted at runtime",
    "$SEED$": "seed integer substituted at runtime"
  },
  "6": {
    "inputs": {
      "text": "$PROMPT$, full body, T-pose, neutral pose, isolated character on plain white background, even studio lighting, no shadows on background, sharp focus, miniature reference photo, tabletop wargame style, 32mm scale, single subject",
      "clip": ["11", 0]
    },
    "class_type": "CLIPTextEncode"
  },
  "7": {
    "inputs": {
      "text": "$NEG$",
      "clip": ["11", 0]
    },
    "class_type": "CLIPTextEncode"
  },
  "10": {
    "inputs": {
      "ckpt_name": "flux/flux1-dev.safetensors"
    },
    "class_type": "CheckpointLoaderSimple"
  },
  "11": {
    "inputs": {
      "clip_name1": "flux/text_encoder/clip_l.safetensors",
      "clip_name2": "flux/text_encoder/t5xxl_fp16.safetensors",
      "type": "flux"
    },
    "class_type": "DualCLIPLoader"
  },
  "13": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage"
  },
  "20": {
    "inputs": {
      "seed": "$SEED$",
      "steps": 28,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["13", 0]
    },
    "class_type": "KSampler"
  },
  "21": {
    "inputs": {
      "samples": ["20", 0],
      "vae": ["10", 2]
    },
    "class_type": "VAEDecode"
  },
  "30": {
    "inputs": {
      "filename_prefix": "tabletop/mini",
      "images": ["21", 0]
    },
    "class_type": "SaveImage"
  }
}
