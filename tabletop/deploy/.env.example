# Copy to .env on the workstation and fill in. NEVER commit .env.
# Hugging Face token for gated/large model downloads (Hunyuan, Z-Image, etc.)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GPU selection. Default: use both 5090s.
#   Both:    GEN3D_GPUS=all
#   Pin GPU1: GEN3D_GPUS=1   and  CUDA_VISIBLE_DEVICES=1
GEN3D_GPUS=all
# CUDA_VISIBLE_DEVICES=1

# Dashboard port — server.js reads DASHBOARD_PORT (host mapping is 7800 in compose)
DASHBOARD_PORT=7800

# ── Quality knobs (defaults are tuned for a 32 GB 5090) ──────────────────────
# Mesh extraction grid. 768 = high (default). 1024 = max detail (slower, ~heavy
# VRAM). 512 = faster. Diminishing returns past 768.
HY_OCTREE=768
# Diffusion steps (shape refinement). 75 single-view / 50 multi-view default.
HY_STEPS=75
# Volume-decode chunk size. Bigger = faster on big VRAM. Lower if you ever OOM.
HY_NUM_CHUNKS=200000
# Force the 16 GB code path (per-stage CPU offload, FlashVDM off). Leave 0 on a
# 5090 — the pipeline auto-detects 24 GB+ and loads full-GPU + FlashVDM.
HY_CPU_OFFLOAD=0
# Concept image resolution. 1280 is near the safe ceiling for SDXL/FLUX-class
# models; going higher risks duplicated subjects. Don't raise without testing.
CONCEPT_RES=1280
