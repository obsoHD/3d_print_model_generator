# syntax=docker/dockerfile:1
# ============================================================
#  3d_print_model_generator — workstation image (dual RTX 5090)
#  Base: CUDA 12.8 devel on Ubuntu 24.04 (native python3.12; 22.04 apt has no
#  3.12). torch cu128 has the Blackwell sm_120 kernels and runs fine on the
#  host's newer driver (confirmed: driver 595 / CUDA 13.2 — forward-compatible).
# ============================================================
FROM nvidia/cuda:12.8.0-devel-ubuntu24.04

# NOTE: PIP_NO_CACHE_DIR is intentionally NOT set — pip installs below use a
# BuildKit cache mount (--mount=type=cache,target=/root/.cache/pip) so wheels
# are cached between builds and a requirements edit no longer re-downloads them.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    TORCH_CUDA_ARCH_LIST="12.0" \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    HF_HOME=/data/hf \
    ATTN_BACKEND=xformers \
    SPCONV_ALGO=native \
    NODE_MAJOR=20

# --- system deps (python, node, build chain, mesh/gl libs) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv python3-pip \
        git git-lfs build-essential cmake ninja-build \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
        libgomp1 curl ca-certificates xvfb \
        blender \
        libgtk-3-0 libwebkit2gtk-4.1-0 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && git lfs install \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# NOTE: do NOT upgrade the Debian-managed pip/setuptools/wheel — they're in
# dist-packages with no RECORD file, so pip can't uninstall them and any
# --upgrade aborts. The system versions (pip 24 / setuptools 68 / wheel 0.42)
# install torch wheels and build diso fine. Just go straight to the installs.

# torch (cu128) in its OWN layer, BEFORE copying requirements — so editing
# requirements.linux.txt never busts the ~4 GB torch download cache.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install torch==2.8.0 torchvision==0.23.0 \
        --index-url https://download.pytorch.org/whl/cu128

# diso (TripoSG DMC): CUDA source build that needs only torch at build time.
# Build it BEFORE the requirements layer so editing requirements never triggers
# a diso recompile. No GPU during `docker build` → torch.cuda.is_available() is
# False and diso's setup.py would fall back to a CPU build (missing
# cuda_runtime.h); FORCE_CUDA=1 makes it use CUDAExtension, and CUDA_HOME + the
# -devel toolkit + TORCH_CUDA_ARCH_LIST=12.0 give nvcc the headers + sm_120.
RUN --mount=type=cache,target=/root/.cache/pip \
    FORCE_CUDA=1 CUDA_HOME=/usr/local/cuda \
    python -m pip install --no-build-isolation diso==0.1.4

# torch-cluster (CraftsMan3D point-sampling): PyG CUDA extension with no prebuilt
# wheel for torch 2.8 cu128, so build from source — also torch-only, also before
# requirements so it caches independently. FORCE_CUDA=1 for the no-GPU build.
RUN --mount=type=cache,target=/root/.cache/pip \
    FORCE_CUDA=1 CUDA_HOME=/usr/local/cuda \
    python -m pip install --no-build-isolation torch-cluster

# --- curated active-engine deps (changes here no longer recompile diso) ---
COPY tabletop/deploy/requirements.linux.txt /tmp/requirements.linux.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -r /tmp/requirements.linux.txt

# --- clone the Hunyuan codebases the engines import (code only; weights -> /data) ---
#   single-view path uses hy3dshape (2.1 repo); mv path uses hy3dgen (2.0 repo)
RUN git clone --depth 1 https://github.com/Tencent-Hunyuan/Hunyuan3D-2.1.git /app/tabletop/Hunyuan3D-2.1 \
 && git clone --depth 1 https://github.com/Tencent/Hunyuan3D-2.git        /app/tabletop/Hunyuan3D-2 \
 && python -m pip install -e /app/tabletop/Hunyuan3D-2.1/hy3dshape || true \
 && python -m pip install -e /app/tabletop/Hunyuan3D-2/hy3dgen      || true

# --- TripoSG engine (SDF image-to-3D, sharpest watertight geometry). Code only;
#     VAST-AI/TripoSG + briaai/RMBG-1.4 weights auto-download at first run to
#     /data (persisted). Uses diso (already built above) for the DMC decoder. ---
RUN git clone --depth 1 https://github.com/VAST-AI-Research/TripoSG.git /app/tabletop/TripoSG

# --- CraftsMan3D engine (coarse 3D diffusion + normal-based geometry refiner;
#     max surface detail). Code only — imported via sys.path (NOT pip-installed,
#     to keep our newer diffusers/transformers). craftsman3d/craftsman-DoraVAE
#     weights auto-download at first run to /data. ---
RUN git clone --depth 1 https://github.com/HKUST-SAIL/CraftsMan3D.git /app/tabletop/CraftsMan3D

# --- TRELLIS.2 + Hi3DGen: clone the code. Hi3DGen imports cleanly on the shared
#     env already. TRELLIS.2 needs its bespoke CUDA exts (built in the next step).
#     (An earlier attempt installed the xformers/spconv/kaolin STACK into the
#     shared env and downgraded a core dep — that is gone. The ext builds below
#     are the SAFE pattern: source compiles only, --no-deps, non-fatal.) ---
RUN git clone --depth 1 https://github.com/microsoft/TRELLIS.2.git /app/tabletop/TRELLIS \
 && git clone --depth 1 https://github.com/Stable-X/Stable3DGen.git /app/tabletop/Stable3DGen

# --- TRELLIS.2 custom CUDA extensions (cumesh / o-voxel / flexgemm + nvdiffrast/
#     nvdiffrec). These are the ModuleNotFoundError('cumesh') blockers. Built from
#     source against the EXISTING torch — the SAFE pattern proven by diso/torch-
#     cluster: FORCE_CUDA + --no-build-isolation compile .so files; --no-deps means
#     they can NOT change torch/numpy (the thing that broke everything before).
#     EACH build is NON-FATAL: if one won't compile on sm_120, TRELLIS.2 simply
#     stays "needs deps" on the health screen and the OTHER 6 engines are untouched.
#     Attention uses the pure-torch 'sdpa' backend (set in the engine), so neither
#     xformers nor flash-attn is needed. ---
RUN --mount=type=cache,target=/root/.cache/pip set +e; \
    export FORCE_CUDA=1 CUDA_HOME=/usr/local/cuda TORCH_CUDA_ARCH_LIST="12.0"; \
    mkdir -p /tmp/ext; \
    ( git clone --recursive https://github.com/JeffreyXiang/CuMesh.git /tmp/ext/CuMesh \
        && python -m pip install /tmp/ext/CuMesh --no-build-isolation --no-deps ) \
        || echo "WARN: cumesh build failed (TRELLIS.2 stays needs-deps)"; \
    ( git clone --recursive https://github.com/JeffreyXiang/FlexGEMM.git /tmp/ext/FlexGEMM \
        && python -m pip install /tmp/ext/FlexGEMM --no-build-isolation --no-deps ) \
        || echo "WARN: flexgemm build failed"; \
    ( python -m pip install /app/tabletop/TRELLIS/o-voxel --no-build-isolation --no-deps ) \
        || echo "WARN: o-voxel build failed"; \
    ( git clone -b v0.4.0 https://github.com/NVlabs/nvdiffrast.git /tmp/ext/nvdiffrast \
        && python -m pip install /tmp/ext/nvdiffrast --no-build-isolation --no-deps ) \
        || echo "WARN: nvdiffrast build failed"; \
    ( git clone -b renderutils https://github.com/JeffreyXiang/nvdiffrec.git /tmp/ext/nvdiffrec \
        && python -m pip install /tmp/ext/nvdiffrec --no-build-isolation --no-deps ) \
        || echo "WARN: nvdiffrec build failed"; \
    rm -rf /tmp/ext; true

# pymeshlab's Qt plugins (used by hy3dshape postprocessors) link libOpenGL.so.0
# et al. Install the GL runtime libs as a late layer so the heavy steps above
# stay cached. Without these, pymeshlab imports but every filter fails to load.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopengl0 libegl1 libglx0 libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

# PrusaSlicer (the slicer-validation oracle). Pull the latest Linux AppImage,
# extract it (no FUSE needed), symlink the CLI. Non-fatal: if it fails, the
# validate step just stays skipped instead of breaking the build.
RUN set -eux; \
    url="$(curl -fsSL https://api.github.com/repos/prusa3d/PrusaSlicer/releases/latest \
          | grep -oE 'https://[^"]*linux-x64[^"]*\.AppImage' | head -1)"; \
    if [ -n "$url" ]; then \
        curl -fL "$url" -o /tmp/prusa.AppImage && chmod +x /tmp/prusa.AppImage; \
        cd /opt && /tmp/prusa.AppImage --appimage-extract >/dev/null; \
        mv squashfs-root prusaslicer; \
        ln -sf /opt/prusaslicer/AppRun /usr/local/bin/prusa-slicer; \
        rm -f /tmp/prusa.AppImage; \
        echo "PrusaSlicer installed: $url"; \
    else echo "WARN: no PrusaSlicer AppImage URL resolved; validate will skip"; fi \
    || echo "WARN: PrusaSlicer install failed; validate will skip"

# --- dashboard runs on Node built-ins only (http/fs/path/child_process/os);
#     no package.json / npm install needed. Node itself is installed above. ---

# --- app code baked into the image (NOT bind-mounted: a read-only mount of the
#     lean GitHub clone would shadow the Hunyuan repos cloned just above).
#     To update code on the box: git pull && docker compose ... up -d --build ---
COPY tabletop /app/tabletop

COPY tabletop/deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 7800
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD curl -fsS http://localhost:7800/ >/dev/null || exit 1

ENTRYPOINT ["/entrypoint.sh"]
