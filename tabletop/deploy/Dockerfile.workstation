# ============================================================
#  3d_print_model_generator — workstation image (dual RTX 5090)
#  Base: CUDA 12.8 devel on Ubuntu 24.04 (native python3.12; 22.04 apt has no
#  3.12). torch cu128 has the Blackwell sm_120 kernels and runs fine on the
#  host's newer driver (confirmed: driver 595 / CUDA 13.2 — forward-compatible).
# ============================================================
FROM nvidia/cuda:12.8.0-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    TORCH_CUDA_ARCH_LIST="12.0" \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    HF_HOME=/data/hf \
    NODE_MAJOR=20

# --- system deps (python, node, build chain, mesh/gl libs) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv python3-pip \
        git git-lfs build-essential cmake ninja-build \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
        libgomp1 curl ca-certificates xvfb \
        blender \
        libgtk-3-0 libwebkit2gtk-4.1-0 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && git lfs install \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# NOTE: do NOT upgrade the Debian-managed pip/setuptools/wheel — they're in
# dist-packages with no RECORD file, so pip can't uninstall them and any
# --upgrade aborts. The system versions (pip 24 / setuptools 68 / wheel 0.42)
# install torch wheels and build diso fine. Just go straight to the installs.

# torch (cu128) in its OWN layer, BEFORE copying requirements — so editing
# requirements.linux.txt never busts the ~4 GB torch download cache.
RUN python -m pip install torch==2.8.0 torchvision==0.23.0 \
        --index-url https://download.pytorch.org/whl/cu128

# --- curated active-engine deps ---
COPY tabletop/deploy/requirements.linux.txt /tmp/requirements.linux.txt
RUN python -m pip install -r /tmp/requirements.linux.txt

# diso (TripoSG DMC): CUDA source build that imports torch at build time, so it
# MUST skip pip build isolation to see the torch installed above.
RUN python -m pip install --no-build-isolation diso==0.1.4

# --- clone the Hunyuan codebases the engines import (code only; weights -> /data) ---
#   single-view path uses hy3dshape (2.1 repo); mv path uses hy3dgen (2.0 repo)
RUN git clone --depth 1 https://github.com/Tencent-Hunyuan/Hunyuan3D-2.1.git /app/tabletop/Hunyuan3D-2.1 \
 && git clone --depth 1 https://github.com/Tencent/Hunyuan3D-2.git        /app/tabletop/Hunyuan3D-2 \
 && python -m pip install -e /app/tabletop/Hunyuan3D-2.1/hy3dshape || true \
 && python -m pip install -e /app/tabletop/Hunyuan3D-2/hy3dgen      || true

# --- dashboard runs on Node built-ins only (http/fs/path/child_process/os);
#     no package.json / npm install needed. Node itself is installed above. ---

# --- app code baked into the image (NOT bind-mounted: a read-only mount of the
#     lean GitHub clone would shadow the Hunyuan repos cloned just above).
#     To update code on the box: git pull && docker compose ... up -d --build ---
COPY tabletop /app/tabletop

COPY tabletop/deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 7800
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD curl -fsS http://localhost:7800/ >/dev/null || exit 1

ENTRYPOINT ["/entrypoint.sh"]
